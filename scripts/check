#!/bin/sh
# usage: scripts/check   every check CI runs. Needs the tools from `nix develop`.
set -eu
cd "$(dirname "$0")/.."
r=$(mktemp); trap 'rm -f "$r"' EXIT

echo "== kustomize";  kubectl kustomize clusters/kratos >/dev/null; { kubectl kustomize platform; echo ---; kubectl kustomize apps; } >"$r"
# Secrets skipped: SOPS adds a "sops:" block that Flux strips, repocheck checks them
echo "== schemas";    kubeconform -strict -summary -ignore-missing-schemas -skip Secret \
  -schema-location default \
  -schema-location 'https://raw.githubusercontent.com/datreeio/CRDs-catalog/main/{{.Group}}/{{.ResourceKind}}_{{.ResourceAPIVersion}}.json' - <"$r"
echo "== policy";     (cd services/repocheck && go run .) <"$r"
echo "== llm models";  (cd services/llmconf && go run . -dir ../../platform/llm -check)
echo "== alerts"
out=$(vmalert -rule='platform/monitoring/rules/*.yaml' -dryRun 2>&1) || { echo "$out"; exit 1; }
amtool check-config platform/monitoring/alertmanager.yaml >/dev/null
echo "== go"
for d in services/*/; do
  (cd "$d" && test -z "$(gofmt -l .)" && go vet ./... && go test -race ./...)
done
echo "== secrets";    gitleaks detect --no-banner --redact
echo "ok"
