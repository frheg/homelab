#!/usr/bin/env bash
# usage: athena-live [flags for athena-live]
# Talk with Athena out loud on kratos: the owl in the terminal. Starts speech recognition (whisper.cpp with OpenAI
# Whisper small, on the CPU) for as long as it runs, then ~/.local/lib/athena/athena-live (from ~/athena:
# scripts/clients ~/.local/lib/athena) with Athena's address and sign-in from ~/.config/athena/client.env.
# The camera comes from camview-web (http://127.0.0.1:8410). nix builds it with its model: nix profile add ~/homelab#athena-live
set -euo pipefail

model=${ATHENA_LIVE_MODEL:-${WHISPER_MODEL:?the speech recognition model}}
port=${ATHENA_LIVE_STT_PORT:-8420}
log=${XDG_RUNTIME_DIR:-/tmp}/athena-live-stt.log

# 8 threads leave room for the chat model's experts, which also run on the CPU; -ac 768 reads 15 s at most, which
# makes it about twice as fast as reading the full 30 s window
whisper-server -m "$model" --host 127.0.0.1 --port "$port" -t 8 -l auto -bs 1 -bo 1 -nf -fa -ac 768 >"$log" 2>&1 &
stt=$!
trap 'kill "$stt" 2>/dev/null || true' EXIT
for _ in $(seq 1 150); do
  curl -sf "http://127.0.0.1:$port/" >/dev/null 2>&1 && break
  kill -0 "$stt" 2>/dev/null || { echo "athena-live: speech recognition did not start, see $log" >&2; exit 1; }
  sleep 0.2
done

set -a
# shellcheck disable=SC1091
. "$HOME/.config/athena/client.env"
set +a
"$HOME/.local/lib/athena/athena-live" -stt "http://127.0.0.1:$port" "$@"
