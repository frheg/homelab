#!/bin/sh
# usage: scripts/neo4j-set-password
# The migrated Neo4j database keeps the password it had ("homelab-graph"); the env
# var only applies to a new database. This sets the strong one from the SOPS secret, once.
set -eu
cd "$(dirname "$0")/.."
new=$(sops -d --extract '["stringData"]["NEO4J_PASSWORD"]' platform/neo4j/secret.sops.yaml)
kubectl -n neo4j exec deploy/neo4j -- cypher-shell -u neo4j -p homelab-graph \
  "ALTER CURRENT USER SET PASSWORD FROM 'homelab-graph' TO '$new'"
echo "neo4j password is now the one in platform/neo4j/secret.sops.yaml"
